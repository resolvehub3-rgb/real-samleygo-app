# Copy to `.env` and fill in. Vite only exposes VITE_* vars to the client.
# Maps are loaded through src/lib/googleMaps.ts.

# Google Maps JavaScript API key (browser key, restricted by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourKeyHere

# Map ID for Advanced Markers — use DEMO_MAP_ID while developing
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# OSRM-compatible routing API (`…/route/v1`) used for road routes and
# turn-by-turn navigation. Leave empty to use the public demo endpoint, or
# point it at a self-hosted / proxied engine. NEVER put a secret key here —
# Vite inlines VITE_* vars into the client bundle.
VITE_ROUTING_API_URL=
